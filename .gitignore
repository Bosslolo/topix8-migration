# Never commit live TOPIX databases or journals
*.4DD
*.4DIndx
*.4DIndy
*.journal
*.Match
*.4DC
*.4dbase/
**/Replaced Files*/

# Large installers — GitHub blocks >100MB in git; use Release topix8-binaries
*.exe
*.msi
*.zip
!scripts/**
# HASP driver packages (sys/inf) ARE committed under hasp-drivers/

# OS / editor
Thumbs.db
Desktop.ini
.DS_Store
*.tmp
*.log
.vs/
.idea/

# Secrets
.env
*.token
*credentials*

# Local inventory dumps — allow text reports, ignore anything else
inventory-output/*
!inventory-output/.gitkeep
!inventory-output/*.txt
